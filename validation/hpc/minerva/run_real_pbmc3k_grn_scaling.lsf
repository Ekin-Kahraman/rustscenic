#BSUB -J rustscenic_pbmc3k_grn_scaling
#BSUB -P acc_DiseaseGeneCell
#BSUB -q express
#BSUB -n 16
#BSUB -R "span[hosts=1] rusage[mem=4000]"
#BSUB -M 4000
#BSUB -W 03:00
#BSUB -o /sc/arion/projects/DiseaseGeneCell/Huang_lab_projects/rustscenic/logs/%J.pbmc3k_grn_scaling.out
#BSUB -e /sc/arion/projects/DiseaseGeneCell/Huang_lab_projects/rustscenic/logs/%J.pbmc3k_grn_scaling.err
#BSUB -L /bin/bash

set -euo pipefail

module load python/3.12.5
unset PYTHONPATH PYTHONHOME
export PYTHONNOUSERSITE=1
export OMP_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export MKL_NUM_THREADS=1
export RAYON_NUM_THREADS="${LSB_DJOB_NUMPROC:-16}"
export TMPDIR=/sc/arion/work/kahrae01/rustscenic/tmp
export RUSTSCENIC_LSF_PROJECT=acc_DiseaseGeneCell
export RUSTSCENIC_LSF_QUEUE=express
export RUSTSCENIC_LSF_CORES=16
export RUSTSCENIC_LSF_MEM_MB=4000
export RUSTSCENIC_LSF_WALLTIME=03:00

PROJECT=/sc/arion/projects/DiseaseGeneCell/Huang_lab_projects/rustscenic
ENV=/sc/arion/work/kahrae01/rustscenic/envs/rustscenic-v047
REPO="${PROJECT}/repo"
DATA_DIR="${REPO}/validation/real_multiome_v036"
OUT_JSON="${PROJECT}/results/real_pbmc3k_grn_scaling_$(date +%Y%m%d_%H%M%S).json"
GRN_N_ESTIMATORS="${GRN_N_ESTIMATORS:-100}"

mkdir -p "${PROJECT}/logs" "${PROJECT}/results" "${TMPDIR}"

. "${ENV}/bin/activate"
cd "${REPO}"

python validation/hpc/minerva/prepare_real_pbmc3k_data.py \
  --data-dir "${DATA_DIR}" \
  --json-out "${OUT_JSON%.json}.data.json"

echo "host=$(hostname)"
echo "date=$(date -Is)"
echo "python=$(python --version)"
echo "repo_sha=$(git rev-parse --short HEAD)"
echo "result_json=${OUT_JSON}"
echo "RAYON_NUM_THREADS=${RAYON_NUM_THREADS}"
echo "lsf_request=project:${RUSTSCENIC_LSF_PROJECT},queue:${RUSTSCENIC_LSF_QUEUE},cores:${RUSTSCENIC_LSF_CORES},mem_mb:${RUSTSCENIC_LSF_MEM_MB},walltime:${RUSTSCENIC_LSF_WALLTIME}"
echo "rustscenic_doctor_json_begin"
python -m rustscenic doctor --json
echo "rustscenic_doctor_json_end"
echo "python_hot_paths_json_begin"
python validation/python_hot_paths.py python/rustscenic --json
echo "python_hot_paths_json_end"

python validation/hpc/minerva/preflight_minerva.py \
  --repo "${REPO}" \
  --env "${ENV}" \
  --data-dir "${DATA_DIR}" \
  --out-json "${OUT_JSON%.json}.preflight.json" \
  --require-repo-import \
  --require-thread-pins \
  --require-data-hashes \
  --require-rust-hot-paths \
  --require-clean

/usr/bin/time -v python validation/scaling/bench_real_pbmc3k_grn_scaling.py \
  --data-dir "${DATA_DIR}" \
  --out "${OUT_JSON}" \
  --subset-sizes 500 1000 2000 2767 \
  --subset-threads 4 \
  --thread-cells 1000 \
  --thread-counts 1 2 4 8 16 \
  --n-estimators "${GRN_N_ESTIMATORS}" \
  --max-features 0.1 \
  --subsample 0.9 \
  --max-depth 3 \
  --early-stop-window 25 \
  --early-stop-mode arboreto \
  --seed 777 \
  --require-clean

python validation/hpc/minerva/validate_benchmark_artifact.py \
  "${OUT_JSON}"

python validation/hpc/minerva/collect_benchmark_results.py \
  "${OUT_JSON}"

echo "RESULT_JSON=${OUT_JSON}"
